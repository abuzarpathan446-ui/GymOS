NODE_ENV=development
HOST=0.0.0.0
PORT=3001
APP_ORIGIN=http://localhost:5173
# Optional comma-separated additional trusted browser origins. Never use '*'.
# For LAN access set APP_ORIGIN to the LAN URL and list localhost here if needed.
ALLOWED_ORIGINS=http://127.0.0.1:5173
# Production requires PostgreSQL. Empty uses local embedded PostgreSQL for development.
DATABASE_URL=
# Separate migration owner; runtime login must be a non-superuser, non-BYPASSRLS role.
MIGRATION_DATABASE_URL=
DATABASE_SSL=false
SESSION_HOURS=12
TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Email delivery also requires PostgreSQL and a running worker (npm run worker).
# The values below are reserved for adapters that are not implemented yet.
# WhatsApp click-to-chat uses the gym's signed-in WhatsApp account; no token is required.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WEBHOOK_SECRET=
PAYMENT_PROVIDER=
PAYMENT_SECRET=
AI_PROVIDER=
AI_API_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
BACKUP_DIRECTORY=./backups
BACKUP_INTERVAL_HOURS=24
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep separately from backup files. Loss of this key means backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
# Set only for db:seed; at least 12 characters. Never seed production.
SEED_PASSWORD=
# Only for provisioning PostgreSQL through compose.yaml; not used in embedded mode.
POSTGRES_PASSWORD=
